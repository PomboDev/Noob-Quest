--[=[
	Writes `src/core/TrigTables.luau`: the lookup tables behind `core/Angle`.

	The simulation can't call `math.sin` or `math.atan2` (libm results may
	differ in the last bit between Roblox, Lune and phones), so it reads these
	literals instead. The numbers are printed with 17 significant digits, which
	parse back to the same double on every runtime. Run it with
	`pesde run gentrig` and commit the result; `tests/Angle.spec.luau` checks
	that the file still matches `math.sin` and `math.atan`.
]=]

local fs = require("@lune/fs")

local STEPS = 1024
local PER_LINE = 4
local OUTPUT = "src/core/TrigTables.luau"

-- Binary angle units in a quarter turn (a full turn is 65536).
local QUARTER = 16384
-- Binary angle units per radian.
local PER_RADIAN = 65536 / (2 * math.pi)

local function literal(value: number): string
	local text = string.format("%.17g", value)
	-- A bare "0" or "1" is fine as a Luau number literal.
	return text
end

local function block(name: string, values: { number }): string
	local lines = { `TrigTables.{name} = \{` }
	local row = {}
	for index, value in values do
		table.insert(row, literal(value))
		if #row == PER_LINE or index == #values then
			table.insert(lines, `\t{table.concat(row, ", ")},`)
			row = {}
		end
	end
	table.insert(lines, "}")
	return table.concat(lines, "\n")
end

local sine = {}
local atan = {}
for index = 0, STEPS do
	-- sin over the first quarter turn.
	table.insert(sine, math.sin(index / STEPS * math.pi / 2))
	-- atan of the ratio index / STEPS (0 to 1), in binary angle units.
	table.insert(atan, math.atan(index / STEPS) * PER_RADIAN)
end
assert(#sine == STEPS + 1 and sine[STEPS + 1] == 1, "sine table must end on exactly 1")
assert(math.abs(atan[STEPS + 1] - QUARTER / 2) < 1e-9, "atan(1) must be an eighth of a turn")
atan[STEPS + 1] = QUARTER / 2

local source = table.concat({
	"--!strict",
	"-- stylua: ignore-start",
	"",
	"-- Generated by tools/gentrig.luau. Do not edit.",
	"",
	"local TrigTables = {}",
	"",
	`-- sin(i / {STEPS} * pi / 2) for i = 0 to {STEPS}: the first quarter turn.`,
	block("SINE", sine),
	"",
	`-- atan(i / {STEPS}) in binary angle units (65536 per turn) for i = 0 to {STEPS}.`,
	block("ATAN", atan),
	"",
	"return TrigTables",
	"-- stylua: ignore-end",
	"",
}, "\n")

fs.writeFile(OUTPUT, source)
print(`✅ Wrote {OUTPUT}`)
